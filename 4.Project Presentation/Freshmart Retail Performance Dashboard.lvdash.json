{
  "datasets": [
    {
      "name": "freshmart_main",
      "displayName": "Freshmart Main Data",
      "queryLines": [
        "SELECT\n",
        "  t.transaction_id,\n",
        "  t.store_id,\n",
        "  CAST(t.transaction_date AS DATE) as transaction_date,\n",
        "  t.day_of_week,\n",
        "  t.customer_id,\n",
        "  t.is_loyalty_member,\n",
        "  t.num_items,\n",
        "  t.basket_value_zar,\n",
        "  t.payment_method,\n",
        "  DATE_TRUNC('MONTH', CAST(t.transaction_date AS DATE)) as transaction_month,\n",
        "  CASE\n",
        "    WHEN MONTH(CAST(t.transaction_date AS DATE)) <= 6 THEN 'H1'\n",
        "    ELSE 'H2'\n",
        "  END as half_year,\n",
        "  s.store_name,\n",
        "  s.province,\n",
        "  s.store_format,\n",
        "  s.floor_area_sqm,\n",
        "  s.opened_year,\n",
        "  s.region_manager,\n",
        "  s.has_nearby_competitor,\n",
        "  CAST(s.competitor_open_date AS DATE) as competitor_open_date\n",
        "FROM\n",
        "  read_files(\n",
        "    '/Volumes/workspace/default/freshmart_stores/1788896715052_freshmart_transactions.csv',\n",
        "    format => 'csv',\n",
        "    header => true\n",
        "  ) t\n",
        "    LEFT JOIN read_files(\n",
        "      '/Volumes/workspace/default/freshmart_stores/1788896696465_freshmart_stores.csv',\n",
        "      format => 'csv',\n",
        "      header => true,\n",
        "      delimiter => '\\t'\n",
        "    ) s\n",
        "      ON t.store_id = s.store_id"
      ]
    }
  ],
